<?xml version="1.0" encoding="utf-8"?>
<go-plugin id="chartmuseum-repo" version="1">
    <about>
        <name>GoCD ChartMuseum Material Poller Plugin</name>
        <version>${project.version}</version>
        <target-go-version>${gocd.min.version}</target-go-version>
        <description>Polls a ChartMuseum server for new versions of a Helm chart, optionally within a version range.</description>
        <vendor>
            <name>Alin Screciu</name>
            <url>https://github.com/AlinScreciu/gocd-chartmuseum-package-repo-plugin</url>
        </vendor>
    </about>
</go-plugin>
